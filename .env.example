# Discord webhook URL for the #bounties channel
# Get it from: Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_NOXCRAFT=https://discord.com/api/webhooks/...

# GitHub token (optional) - increases API rate limit from 60 to 5000 req/hr
# Needed if you add GitHub language lookups for bounties with no tech metadata
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=ghp_...
