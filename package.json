{
  "name": "bounty-hunter",
  "version": "1.0.0",
  "description": "Scans Algora and IssueHunt for open Rust bounties and posts results to Discord",
  "type": "module",
  "scripts": {
    "scan": "tsx src/index.ts",
    "scan:dry": "tsx src/index.ts --dry-run",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
